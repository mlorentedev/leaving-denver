build/
data/inventory.json

# Python & Tests
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Temporary / Scratch & Raw Assets
.scratch/
log/
tmp/
images/
content/raw_heic/
*.odt
*.tmp
*.swp
*~
.DS_Store

# IDEs
.idea/
.vscode/

# Tooling
.venv/
node_modules
*.egg-info/
